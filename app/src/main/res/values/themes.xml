<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoviePortal" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.MoviePortal.Player" parent="Theme.MoviePortal">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Widget.MoviePortal.Button" parent="android:Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Dialogs (track choice, stop/disconnect confirmation, rename) in the app's look instead of the system one -->
    <style name="Theme.MoviePortal.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_list_item</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.MoviePortal.Button.Dialog</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.MoviePortal.Button.Dialog</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.MoviePortal.Button.Dialog</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.MoviePortal.Button.Dialog</item>
    </style>

    <style name="Widget.MoviePortal.Button.Dialog">
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.MoviePortal.IconButton" parent="android:Widget.DeviceDefault.ImageButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:nextFocusUp">@id/player_timebar</item>
    </style>

    <!-- Layouts that stack on narrow (portrait phone) screens and line up side by side from 600dp (values-w600dp) -->
    <style name="Layout.MoviePortal.ButtonRow" parent="">
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.MoviePortal.Button.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Layout.MoviePortal.QrScreen" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="Layout.MoviePortal.QrText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/qr_text_gap</item>
    </style>

    <style name="Widget.MoviePortal.Input" parent="android:Widget.DeviceDefault.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Text.MoviePortal.Label" parent="android:TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.MoviePortal.Body" parent="android:TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.MoviePortal.Title" parent="android:TextAppearance.DeviceDefault">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
