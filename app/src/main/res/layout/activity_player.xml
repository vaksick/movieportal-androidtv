<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:show_buffering="never"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/player_loading"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <!-- Minimal control panel: timeline, audio and subtitle selection -->
    <LinearLayout
        android:id="@+id/player_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="96dp"
        android:paddingEnd="64dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/player_title"
            style="@style/Text.MoviePortal.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="26sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/player_timebar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:nextFocusDown="@id/player_play_pause"
            app:played_color="@color/accent"
            app:scrubber_color="@color/accent"
            app:scrubber_drawable="@drawable/timebar_scrubber" />

        <!-- Icon controls like the portal's web player -->
        <LinearLayout
            android:id="@+id/player_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_play_pause"
                style="@style/Widget.MoviePortal.IconButton"
                android:contentDescription="@string/player_pause"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/player_rewind"
                style="@style/Widget.MoviePortal.IconButton"
                android:contentDescription="@string/player_rewind"
                android:src="@drawable/ic_replay_10" />

            <ImageButton
                android:id="@+id/player_forward"
                style="@style/Widget.MoviePortal.IconButton"
                android:contentDescription="@string/player_forward"
                android:src="@drawable/ic_forward_10" />

            <!-- Shown only when a next episode / queued item exists -->
            <ImageButton
                android:id="@+id/player_next"
                style="@style/Widget.MoviePortal.IconButton"
                android:contentDescription="@string/player_next_episode"
                android:src="@drawable/ic_skip_next"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_time"
                style="@style/Text.MoviePortal.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="monospace" />

            <ImageButton
                android:id="@+id/player_tracks_button"
                style="@style/Widget.MoviePortal.IconButton"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/player_tracks"
                android:src="@drawable/ic_subtitles" />
        </LinearLayout>

    </LinearLayout>

    <!-- Audio and subtitle choice, above the control panel on the right (like the portal's web player) -->
    <LinearLayout
        android:id="@+id/player_tracks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_tracks"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="@dimen/track_column_width"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Text.MoviePortal.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/player_audio"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/player_tracks_audio_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/player_tracks_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/track_column_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/Text.MoviePortal.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/player_subtitles"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/player_tracks_subtitles_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/player_tracks_subtitles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
